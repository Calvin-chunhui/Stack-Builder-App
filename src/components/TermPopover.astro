---
/**
 * The glossary popover. One instance per page; any `.term` or `[data-term]`
 * trigger anywhere in the document opens it.
 *
 * Definitions are embedded as JSON rather than fetched, because the whole
 * glossary is 80 short records and this keeps the interaction instant with no
 * network request and no framework.
 */
import { TERMS } from '../lib/glossary';
import { layerName } from '../data/taxonomy';

const payload = TERMS.map((t) => ({
  id: t.id,
  term: t.term,
  definition: t.definition,
  like: t.like,
  layer: t.layer,
  layerName: t.layer ? layerName(t.layer) : null,
}));
---

<div class="term-pop" id="termPop" role="dialog" aria-label="Definition" hidden></div>

<script type="application/json" id="termData" is:inline set:html={JSON.stringify(payload)} />

<script>
  interface TermData {
    id: string;
    term: string;
    definition: string;
    like: string | null;
    layer: string | null;
    layerName: string | null;
  }

  const raw = document.getElementById('termData')?.textContent ?? '[]';
  const terms = new Map<string, TermData>(
    (JSON.parse(raw) as TermData[]).map((t) => [t.id, t]),
  );

  const pop = document.getElementById('termPop') as HTMLElement | null;

  const esc = (s: unknown) =>
    String(s ?? '').replace(
      /[&<>"']/g,
      (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!,
    );

  function closeTerm() {
    if (pop) pop.hidden = true;
  }

  function openTerm(id: string, anchor: Element | null) {
    const t = terms.get(id);
    if (!t || !pop) return;

    pop.innerHTML = `
      <div class="tp-head"><strong>${esc(t.term)}</strong>
        <button class="tp-close" data-closeterm aria-label="Close">&times;</button></div>
      <p>${esc(t.definition)}</p>
      ${t.like ? `<p class="tp-like"><span>Like</span> ${esc(t.like)}</p>` : ''}
      <div class="tp-foot">
        ${t.layer ? `<a class="chip" href="/library/${t.layer}">About ${esc(t.layerName)}</a>` : ''}
        <a class="chip" href="/glossary#g-${esc(t.id)}">Open glossary</a>
      </div>`;
    pop.hidden = false;

    // Anchor under the trigger on desktop; pin to the bottom on small screens.
    const r = anchor?.getBoundingClientRect();
    const w = Math.min(340, window.innerWidth - 24);
    pop.style.width = `${w}px`;

    if (r && window.innerWidth > 640) {
      const left = Math.min(Math.max(12, r.left), window.innerWidth - w - 12);
      let top = r.bottom + 8;
      if (top + 220 > window.innerHeight) top = Math.max(12, r.top - 8 - pop.offsetHeight);
      pop.style.left = `${left}px`;
      pop.style.top = `${top}px`;
      pop.style.right = 'auto';
      pop.style.bottom = 'auto';
    } else {
      pop.style.left = '12px';
      pop.style.right = '12px';
      pop.style.top = 'auto';
      pop.style.bottom = '12px';
      pop.style.width = 'auto';
    }

    pop.querySelector<HTMLElement>('.tp-close')?.focus();
  }

  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    if (!target) return;

    const trigger = target.closest<HTMLElement>('[data-term]');
    if (trigger) {
      openTerm(trigger.dataset.term!, trigger);
      return;
    }
    if (target.closest('[data-closeterm]')) {
      closeTerm();
      return;
    }
    if (!target.closest('#termPop')) closeTerm();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeTerm();
  });
</script>
