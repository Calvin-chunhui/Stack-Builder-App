    {
      "label": "TypeScript",
      "language": "ts",
      "code": "import { pgTable, serial, text, integer } from \"drizzle-orm/pg-core\";\nimport { eq } from \"drizzle-orm\";\n\nexport const orders = pgTable(\"orders\", {\n  id: serial(\"id\").primaryKey(),\n  item: text(\"item\").notNull(),\n  userId: integer(\"user_id\").notNull(),\n});\n\n// Reads almost like SQL\nconst rows = await db.select().from(orders).where(eq(orders.userId, 42));"
