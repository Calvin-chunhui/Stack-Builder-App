      "code": "pipeline {\n  agent { docker { image 'node:24' } }\n  stages {\n    stage('Install') { steps { sh 'npm ci' } }\n    stage('Test')    { steps { sh 'npm test' } }\n    stage('Deploy') {\n      when { branch 'main' }\n      steps { sh './deploy.sh' }\n    }\n  }\n}"
