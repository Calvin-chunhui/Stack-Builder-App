  "codeSamples": [
    {
      "label": "TypeScript",
      "language": "ts",
      "code": "// server: define a procedure\nexport const appRouter = router({\n  greet: publicProcedure\n    .input(z.object({ name: z.string() }))\n    .query(({ input }) => ({ message: `Hello, ${input.name}` })),\n});\nexport type AppRouter = typeof appRouter;\n\n// client: call it like a local function, fully typed\nconst { message } = await trpc.greet.query({ name: \"Ada\" });"
    }
