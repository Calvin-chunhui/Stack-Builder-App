---
/**
 * The shell every page shares: header, search, footer and the glossary
 * popover. Ships no framework JavaScript; only the small inline scripts below.
 */
import '../styles/global.css';
import TermPopover from '../components/TermPopover.astro';
import { ICON } from '../lib/icons';

interface Props {
  title: string;
  description: string;
  /** Which top-level tab to mark as current. */
  section?: 'learn' | 'builder' | 'library';
  /** Absolute or root-relative OG image. Defaults to the generated site card. */
  ogImage?: string;
  /** Keep a page out of the Pagefind index (the builder and shared stacks). */
  noIndex?: boolean;
}

const { title, description, section, ogImage, noIndex = false } = Astro.props;

const siteName = 'Stack Builder';
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = ogImage ? new URL(ogImage, Astro.site) : new URL('/api/og', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noIndex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="topbar">
      <a class="brand" href="/" aria-label="Stack Builder, go to Learn">
        <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
        Stack Builder
      </a>

      <nav class="viewtabs" aria-label="Views">
        <a href="/" aria-current={section === 'learn' ? 'page' : undefined}>Learn</a>
        <a href="/builder" aria-current={section === 'builder' ? 'page' : undefined}>Builder</a>
        <a href="/library" aria-current={section === 'library' ? 'page' : undefined}>Library</a>
      </nav>

      <form class="search" role="search" action="/search" method="get">
        <Fragment set:html={ICON.search} />
        <label class="sr-only" for="q">Search tools, languages or jobs</label>
        <input
          type="search"
          id="q"
          name="q"
          placeholder="Search tools, languages or jobs"
          autocomplete="off"
        />
      </form>

      <div class="topbar-actions">
        <a class="btn-ghost" href="/library/recipes">
          <span class="hide-sm">Stack recipes</span><span class="show-sm">Recipes</span>
        </a>
        <a class="btn-ghost" href="/builder">New stack</a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <p class="footer-note">
      Survey figures: Stack Overflow Developer Survey 2025 (all respondents; the 2026 survey opened
      June 23, 2026 and its results aren't out yet) and State of JavaScript 2025. Prices checked
      September 2026 against vendor pages; they change often, so confirm before you budget.
      Feasibility checks are guidance based on documented capabilities, not guarantees.
    </p>

    <TermPopover />
    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script>
      // Shared toast + clipboard helpers, used by the code blocks and the
      // builder island. Exposed on window so an island can reuse them.
      function toast(message: string) {
        const el = document.getElementById('toast');
        if (!el) return;
        el.textContent = message;
        el.classList.add('show');
        window.clearTimeout((window as any).__toastTimer);
        (window as any).__toastTimer = window.setTimeout(() => el.classList.remove('show'), 1900);
      }

      async function copyText(text: string): Promise<boolean> {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          // Clipboard API needs a secure context and permission; fall back.
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          let ok = false;
          try {
            ok = document.execCommand('copy');
          } catch {
            ok = false;
          }
          ta.remove();
          return ok;
        }
      }

      (window as any).sbToast = toast;
      (window as any).sbCopy = copyText;

      // Copy buttons on code samples.
      document.addEventListener('click', async (e) => {
        const btn = (e.target as Element | null)?.closest<HTMLElement>('[data-copy-target]');
        if (!btn) return;
        const pre = document.getElementById(btn.dataset.copyTarget!);
        if (!pre) return;
        const ok = await copyText(pre.textContent ?? '');
        toast(ok ? 'Code copied' : 'Copy failed, select the code manually');
      });
    </script>
  </body>
</html>
