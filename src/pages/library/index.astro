---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LibNav from '../../components/LibNav.astro';
import { LAYERS, layerColor } from '../../data/taxonomy';

const tools = await getCollection('tools');
const layerDocs = await getCollection('layers');

const placeOf = (id: string) => layerDocs.find((l) => l.data.id === id)?.data.place ?? '';
const countIn = (id: string) => tools.filter((t) => t.data.layer === id).length;
---

<Base
  title="Tech stack library"
  description={`What each of ${tools.length} tools is, when it appeared, how it's written, what it pairs with and where it falls short.`}
  section="library"
>
  <div class="lib">
    <LibNav current="all" />
    <div>
      <div class="lib-intro">
        <h1>Tech stack library</h1>
        <p>
          What each tool is, when it appeared, how it's written, what it pairs with and where it
          falls short. Start with a layer to read a plain-language introduction first. {tools.length}
          {' '}tools across eight layers.
        </p>
      </div>

      <div class="layer-cards">
        {
          LAYERS.map((L) => (
            <a class="layer-card" href={`/library/${L.id}`} style={`--c:${layerColor(L.id)}`}>
              <span class="lc-name">
                {L.name}
                {L.optional && <small>optional</small>}
              </span>
              <span class="lc-place">{placeOf(L.id)}</span>
              <span class="lc-blurb">{L.blurb}</span>
              <span class="lc-count">{countIn(L.id)} tools</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</Base>
